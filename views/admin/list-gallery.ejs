<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Gallery | Admin Panel</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-light">

    <div class="container py-5">
        
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="h3 mb-0">Gallery Management</h1>
                <p class="text-muted">Upload and manage images for your gallery page.</p>
            </div>
            <a href="/admin" class="btn btn-secondary">
                <i class="fas fa-arrow-left me-2"></i>Back to Dashboard
            </a>
        </div>
        <div class="card mb-4 border-0 shadow-sm">
            <div class="card-body d-flex gap-2 bg-white rounded">
                <form action="/admin/undo/gallery" method="POST" class="d-inline">
                    <button type="submit" class="btn btn-warning text-dark">
                        <i class="fas fa-undo me-2"></i>Undo
                    </button>
                </form>
                <form action="/admin/restore/gallery" method="POST" class="d-inline" onsubmit="return confirm('Reset Gallery to factory defaults? All uploaded images will be removed from the list.');">
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-history me-2"></i>Restore Defaults
                    </button>
                </form>
            </div>
        </div>

        <div class="card shadow-sm mb-5">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="fas fa-plus-circle me-2"></i>Add New Image</h5>
            </div>
            <div class="card-body">
                <form action="/admin/add/gallery" method="POST" enctype="multipart/form-data">
                    <div class="row g-3 align-items-end">
                        <div class="col-md-5">
                            <label class="form-label fw-bold">Select Image</label>
                            <input type="file" name="image" class="form-control" required>
                        </div>
                        <div class="col-md-5">
                            <label class="form-label fw-bold">Caption (Optional)</label>
                            <input type="text" name="caption" class="form-control" placeholder="Enter a short description...">
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-success w-100">
                                <i class="fas fa-upload me-2"></i>Upload
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <h4 class="mb-3">Existing Images</h4>
        
        <% if (list && list.length > 0) { %>
            <div class="row g-4">
                <% list.forEach(function(item, index) { %>
                    <div class="col-md-4 col-lg-3">
                        <div class="card h-100 shadow-sm">
                            <div class="ratio ratio-4x3">
                                <img src="/<%= item.src ? (item.src.startsWith('assets/') ? item.src.replace('assets/', '') : item.src) : 'images/placeholder.jpg' %>" 
                                     class="card-img-top object-fit-cover" alt="Gallery Image">
                            </div>
                            <div class="card-body d-flex flex-column">
                                <p class="card-text small text-muted mb-3 flex-grow-1">
                                    <%= item.caption || 'No caption provided' %>
                                </p>
                                <form action="/admin/delete/gallery/<%= index %>" method="POST" 
                                      onsubmit="return confirm('Are you sure you want to delete this image?');">
                                    <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                                        <i class="fas fa-trash-alt me-2"></i>Delete
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } else { %>
            <div class="alert alert-info text-center py-5">
                <i class="fas fa-images fa-3x mb-3 text-muted"></i>
                <h5>No images in gallery yet.</h5>
                <p>Use the form above to upload your first image.</p>
            </div>
        <% } %>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>