<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Global Settings | Admin Panel</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-light">

    <div class="container py-5">
        
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="h3 mb-0">Global Settings</h1>
                <p class="text-muted">Manage site-wide information, contacts, and branding.</p>
            </div>
            <a href="/admin" class="btn btn-secondary">
                <i class="fas fa-arrow-left me-2"></i>Back to Dashboard
            </a>
        </div>

        <div class="card mb-4 border-0 shadow-sm">
            <div class="card-body d-flex gap-2 bg-white rounded">
                <form action="/admin/undo/global" method="POST" class="d-inline">
                    <button type="submit" class="btn btn-warning text-dark">
                        <i class="fas fa-undo me-2"></i>Undo Last Save
                    </button>
                </form>
                <form action="/admin/restore/global" method="POST" class="d-inline" onsubmit="return confirm('WARNING: This will reset all global settings to the factory defaults. Are you sure?');">
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-history me-2"></i>Restore Factory Defaults
                    </button>
                </form>
            </div>
        </div>

        <form action="/admin/save/object/global" method="POST" enctype="multipart/form-data">
            
            <div class="row g-4">
                
                <div class="col-md-6">
                    <div class="card h-100 shadow-sm">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0"><i class="fas fa-tag me-2"></i>Branding</h5>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label class="form-label fw-bold">Site Title</label>
                                <input type="text" name="siteTitle" class="form-control" value="<%= data.siteTitle %>">
                                <small class="text-muted">Appears in the browser tab.</small>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Company Name</label>
                                <input type="text" name="companyName" class="form-control" value="<%= data.companyName %>">
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Footer Copyright Text</label>
                                <input type="text" name="footerText" class="form-control" value="<%= data.footerText %>">
                            </div>
                            <hr>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Website Logo</label>
                                <input type="hidden" name="imageField" value="logo">
                                <input type="file" name="image" class="form-control mb-2">
                                
                                <% if (data.logo) { %>
                                    <div class="p-2 border rounded bg-light d-inline-block">
                                        <p class="mb-1 text-muted small">Current Logo:</p>
                                        <img src="/<%= data.logo.startsWith('assets/') ? data.logo.replace('assets/', '') : data.logo %>" alt="Current Logo" style="height: 50px;">
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card h-100 shadow-sm">
                        <div class="card-header bg-success text-white">
                            <h5 class="mb-0"><i class="fas fa-address-book me-2"></i>Contact Info</h5>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label class="form-label fw-bold">Primary Phone</label>
                                <input type="text" name="phonePrimary" class="form-control" value="<%= data.phonePrimary %>">
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Secondary Phone</label>
                                <input type="text" name="phoneSecondary" class="form-control" value="<%= data.phoneSecondary %>">
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Email Address</label>
                                <input type="email" name="email" class="form-control" value="<%= data.email %>">
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Physical Address</label>
                                <textarea name="address" class="form-control" rows="3"><%= data.address %></textarea>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card h-100 shadow-sm">
                        <div class="card-header bg-info text-white">
                            <h5 class="mb-0"><i class="fas fa-share-alt me-2"></i>Social Media</h5>
                        </div>
                        <div class="card-body">
                            <p class="text-muted small">Leave blank to hide the icon on the website.</p>
                            
                            <div class="input-group mb-3">
                                <span class="input-group-text bg-light"><i class="fab fa-facebook text-primary"></i></span>
                                <input type="text" name="socialLinks[facebook]" class="form-control" placeholder="Facebook URL" value="<%= data.socialLinks ? data.socialLinks.facebook : '' %>">
                            </div>
                            
                            <div class="input-group mb-3">
                                <span class="input-group-text bg-light"><i class="fab fa-instagram text-danger"></i></span>
                                <input type="text" name="socialLinks[instagram]" class="form-control" placeholder="Instagram URL" value="<%= data.socialLinks ? data.socialLinks.instagram : '' %>">
                            </div>

                            <div class="input-group mb-3">
                                <span class="input-group-text bg-light"><i class="fa-brands fa-x-twitter text-dark"></i></span>
                                <input type="text" name="socialLinks[twitter]" class="form-control" placeholder="X (Twitter) URL" value="<%= data.socialLinks ? data.socialLinks.twitter : '' %>">
                            </div>

                            <div class="input-group mb-3">
                                <span class="input-group-text bg-light"><i class="fab fa-linkedin text-primary"></i></span>
                                <input type="text" name="socialLinks[linkedin]" class="form-control" placeholder="LinkedIn URL" value="<%= data.socialLinks ? data.socialLinks.linkedin : '' %>">
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card h-100 shadow-sm">
                        <div class="card-header bg-warning text-dark">
                            <h5 class="mb-0"><i class="fas fa-map-marked-alt me-2"></i>Map Settings</h5>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label class="form-label fw-bold">Map Embed URL (src)</label>
                                <textarea name="mapEmbedUrl" class="form-control" rows="4" placeholder="https://www.google.com/maps/embed?..."><%= data.mapEmbedUrl %></textarea>
                                <small class="text-muted d-block mt-2">
                                    Go to Google Maps -> Share -> Embed a map -> Copy HTML -> Extract only the <code>src="..."</code> URL.
                                </small>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <div class="fixed-bottom bg-white border-top shadow p-3 text-end" style="z-index: 1000;">
                <div class="container">
                    <a href="/admin" class="btn btn-secondary me-2">Cancel</a>
                    <button type="submit" class="btn btn-success px-5 fw-bold">
                        <i class="fas fa-save me-2"></i>Save All Changes
                    </button>
                </div>
            </div>
            <div style="height: 100px;"></div>

        </form>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>