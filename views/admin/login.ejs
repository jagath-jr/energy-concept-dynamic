<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Login | Energy Concept</title>
    <link rel="icon" type="image/x-icon" href="/images/titleimg.png">
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <style>
        body {
            background-color: #f4f6f9;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .login-card {
            width: 100%;
            max-width: 400px;
            border: none;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }
        .login-header {
            background-color: #212529; /* Dark Header */
            color: white;
            text-align: center;
            padding: 2rem 1rem;
            border-radius: 0.375rem 0.375rem 0 0;
        }
        .login-logo {
            max-height: 50px;
            margin-bottom: 1rem;
        }
        .btn-primary {
            background-color: #0d6efd;
            padding: 0.75rem;
            font-weight: 500;
        }
    </style>
</head>
<body>

    <div class="card login-card">
        <div class="login-header">
            <h3>Admin Panel</h3>
            <p class="mb-0 text-white-50">Please login to continue</p>
        </div>
        
        <div class="card-body p-4">
            
            <% if (error) { %>
                <div class="alert alert-danger text-center" role="alert">
                    <%= error %>
                </div>
            <% } %>

            <form action="/admin/login" method="POST">
                <div class="mb-3">
                    <label for="username" class="form-label">Username</label>
                    <input type="text" class="form-control" id="username" name="username" placeholder="Enter username" required autofocus>
                </div>
                
                <div class="mb-4">
                    <label for="password" class="form-label">Password</label>
                    <input type="password" class="form-control" id="password" name="password" placeholder="Enter password" required>
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn btn-primary">Login</button>
                </div>
            </form>
        </div>
        
        <div class="card-footer text-center py-3 text-muted border-0 bg-transparent">
            <small>&copy; Energy Concept Admin</small>
        </div>
    </div>

</body>
</html>