<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Projects | Admin Panel</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-light">

    <div class="container py-5">
        
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="h3 mb-0">Manage Projects</h1>
                <p class="text-muted">Update the ongoing projects portfolio.</p>
            </div>
            <a href="/admin" class="btn btn-secondary">
                <i class="fas fa-arrow-left me-2"></i>Back to Dashboard
            </a>
        </div>

        <div class="card mb-4 border-0 shadow-sm">
            <div class="card-body d-flex gap-2 bg-white rounded">
                <form action="/admin/undo/ongoing-project-data" method="POST" class="d-inline">
                    <button type="submit" class="btn btn-warning text-dark">
                        <i class="fas fa-undo me-2"></i>Undo Last Change
                    </button>
                </form>
                <form action="/admin/restore/ongoing-project-data" method="POST" class="d-inline" onsubmit="return confirm('This will reset the projects list to factory defaults. Continue?');">
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-history me-2"></i>Restore Defaults
                    </button>
                </form>
            </div>
        </div>

        <div class="row g-4">
            
            <div class="col-lg-4">
                <div class="card shadow-sm border-0 sticky-top" style="top: 2rem;">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0"><i class="fas fa-plus-circle me-2"></i>Add New Project</h5>
                    </div>
                    <div class="card-body">
                        <form action="/admin/add/projects" method="POST" enctype="multipart/form-data">
                            
                            <div class="mb-3">
                                <label class="form-label fw-bold">Project Title</label>
                                <input type="text" name="title" class="form-control" placeholder="e.g. Substation Upgrade 132kV" required>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">Client Name</label>
                                <input type="text" name="client" class="form-control" placeholder="e.g. DEWA" required>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">Main Contractor</label>
                                <input type="text" name="mainContractor" class="form-control" placeholder="e.g. Siemens" required>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">Project Image</label>
                                <input type="file" name="image" class="form-control" accept="image/*" required>
                                <small class="text-muted">Upload a representative image for this project.</small>
                            </div>

                            <button type="submit" class="btn btn-info text-white w-100 fw-bold">
                                <i class="fas fa-save me-2"></i>Add Project
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <div class="col-lg-8">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white">
                        <h5 class="mb-0">Current Projects List</h5>
                    </div>
                    <div class="card-body p-0">
                        
                        <% if (list && list.length > 0) { %>
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th style="width: 80px;">Image</th>
                                            <th>Project Details</th>
                                            <th class="text-end" style="width: 100px;">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% list.forEach(function(item, index) { %>
                                            <tr>
                                                <td class="text-center">
                                                    <% let imgPath = item.image || item.imageLarge || 'images/titleimg.png'; %>
                                                    <img src="/<%= imgPath.startsWith('assets/') ? imgPath.replace('assets/', '') : imgPath %>" 
                                                         alt="project" 
                                                         class="rounded"
                                                         style="width: 60px; height: 40px; object-fit: cover;">
                                                </td>
                                                <td>
                                                    <h6 class="mb-1 fw-bold"><%= item.title %></h6>
                                                    <div class="small text-muted">
                                                        <i class="fas fa-user-tie me-1"></i> Client: <%= item.client %><br>
                                                        <i class="fas fa-hard-hat me-1"></i> Contractor: <%= item.mainContractor %>
                                                    </div>
                                                </td>
                                                <td class="text-end">
                                                    <form action="/admin/delete/projects/<%= index %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this project?');">
                                                        <button type="submit" class="btn btn-outline-danger btn-sm" title="Delete">
                                                            <i class="fas fa-trash-alt"></i>
                                                        </button>
                                                    </form>
                                                </td>
                                            </tr>
                                        <% }); %>
                                    </tbody>
                                </table>
                            </div>
                        <% } else { %>
                            <div class="text-center py-5">
                                <i class="fas fa-folder-open fa-3x text-muted mb-3"></i>
                                <p class="text-muted">No ongoing projects found.</p>
                            </div>
                        <% } %>

                    </div>
                </div>
            </div>

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>