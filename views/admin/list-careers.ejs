<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Careers | Admin Panel</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-light">

    <div class="container py-5">
        
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="h3 mb-0">Manage Careers</h1>
                <p class="text-muted">Post new job vacancies and manage current openings.</p>
            </div>
            <a href="/admin" class="btn btn-secondary">
                <i class="fas fa-arrow-left me-2"></i>Back to Dashboard
            </a>
        </div>

        <div class="card mb-4 border-0 shadow-sm">
            <div class="card-body d-flex gap-2 bg-white rounded">
                <form action="/admin/undo/job-vacancies" method="POST" class="d-inline">
                    <button type="submit" class="btn btn-warning text-dark">
                        <i class="fas fa-undo me-2"></i>Undo Last Change
                    </button>
                </form>
                <form action="/admin/restore/job-vacancies" method="POST" class="d-inline" onsubmit="return confirm('This will reset the job list to factory defaults. Continue?');">
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-history me-2"></i>Restore Defaults
                    </button>
                </form>
            </div>
        </div>

        <div class="row g-4">
            
            <div class="col-lg-5">
                <div class="card shadow-sm border-0 sticky-top" style="top: 2rem;">
                    <div class="card-header bg-secondary text-white">
                        <h5 class="mb-0"><i class="fas fa-briefcase me-2"></i>Post New Job</h5>
                    </div>
                    <div class="card-body">
                        <form action="/admin/add/careers" method="POST">
                            
                            <div class="mb-3">
                                <label class="form-label fw-bold">Job Title</label>
                                <input type="text" name="title" class="form-control" placeholder="e.g. Electrical Engineer" required>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">Location</label>
                                    <input type="text" name="location" class="form-control" value="Abu Dhabi, UAE" required>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">Job Type</label>
                                    <select name="type" class="form-select">
                                        <option value="Full-time">Full-time</option>
                                        <option value="Part-time">Part-time</option>
                                        <option value="Contract">Contract</option>
                                        <option value="Internship">Internship</option>
                                    </select>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">Job Description & Requirements</label>
                                <textarea name="description" class="form-control" rows="6" placeholder="• Bachelor's degree in Engineering&#10;• 3+ years experience&#10;• Knowledge of SCADA systems" required></textarea>
                                <small class="text-muted d-block mt-1">
                                    <i class="fas fa-info-circle me-1"></i> Tip: Enter each requirement on a new line. The website will format them as bullet points.
                                </small>
                            </div>

                            <button type="submit" class="btn btn-dark w-100 fw-bold">
                                <i class="fas fa-plus me-2"></i>Post Job Vacancy
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <div class="col-lg-7">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white">
                        <h5 class="mb-0">Current Openings</h5>
                    </div>
                    <div class="card-body p-0">
                        
                        <% if (list && list.length > 0) { %>
                            <div class="list-group list-group-flush">
                                <% list.forEach(function(job, index) { %>
                                    <div class="list-group-item p-3">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div>
                                                <h5 class="mb-1 fw-bold text-primary"><%= job.title %></h5>
                                                <div class="mb-2 text-muted small">
                                                    <i class="fas fa-map-marker-alt me-1"></i> <%= job.location %> 
                                                    <span class="mx-2">|</span> 
                                                    <i class="fas fa-clock me-1"></i> <%= job.type %>
                                                </div>
                                                
                                                <div class="small text-secondary bg-light p-2 rounded">
                                                    <% if (Array.isArray(job.description)) { %>
                                                        <ul class="mb-0 ps-3">
                                                            <% job.description.slice(0, 2).forEach(function(line) { %>
                                                                <li><%= line %></li>
                                                            <% }); %>
                                                            <% if (job.description.length > 2) { %>
                                                                <li class="list-unstyled text-muted fst-italic mt-1">
                                                                    + <%= job.description.length - 2 %> more items...
                                                                </li>
                                                            <% } %>
                                                        </ul>
                                                    <% } else { %>
                                                        <%= job.description %>
                                                    <% } %>
                                                </div>
                                            </div>

                                            <form action="/admin/delete/careers/<%= index %>" method="POST" onsubmit="return confirm('Delete this job posting?');">
                                                <button type="submit" class="btn btn-outline-danger btn-sm ms-2" title="Delete">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                <% }); %>
                            </div>
                        <% } else { %>
                            <div class="text-center py-5">
                                <i class="fas fa-user-slash fa-3x text-muted mb-3"></i>
                                <p class="text-muted">No active job openings.</p>
                            </div>
                        <% } %>

                    </div>
                </div>
            </div>

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>