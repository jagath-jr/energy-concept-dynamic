<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { title: (content.pageTitle || 'About Us') + ' | ' + (global.siteTitle || 'Energy Concept'), pageCss: 'about.css' }) %>

<body>
    <%- include('partials/header') %>
    
    <div id="header-placeholder"></div>

    <section class="services-hero">
        <div class="banner" data-aos="fade-down">
            <h2 class="caption"><%= content.pageTitle || 'About Us' %></h2>
        </div>
    </section>

    <section id="about-section" class="about-section">
        <div class="container">
            <div class="about-content">
                <p class="section-paragraph">
                  <%= content.mainDescription %>
                </p>

                <div class="info-boxes-container">
                    <div class="info-box mission-box">
                        <div class="info-box-text">
                            <h3><%= content.visionTitle || 'Vision' %></h3>
                            <p><%= content.visionText %></p>
                        </div>
                    </div>

                    <div class="info-box vision-box">
                        <div class="info-box-text">
                            <h3><%= content.missionTitle || 'Mission' %></h3>
                            <p><%= content.missionText %></p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="about-image">
                <img src="<%= content.mainImage || 'images/aboutus-visionsection.webp' %>" 
                     alt="About Us Image">
            </div>
        </div>
    </section>

    <section class="offer-section">
        <h2>What We Offer</h2>
        
        <div class="offer-cards">
            <% if (content.offers && content.offers.length > 0) { %>
                <% content.offers.forEach(function(offer, index) { %>
                    <div class="offer-card" data-aos="fade-up" data-aos-delay="<%= (index + 1) * 100 %>">
                        <div class="offer-card-icon">
                            <i class="<%= offer.icon %>"></i>
                        </div>
                        <div><%= offer.text %></div>
                    </div>
                <% }); %>
            <% } %>
        </div>
    </section>

    <main class="cert-main">
        <section class="cert-section">
            <div class="cert-container">
                
                <header class="cert-header">
                    <h1 class="cert-title">Our Certifications</h1>
                </header>

                <article class="cert-thumbnail-wrapper">
                    <% var cert = (content.certifications && content.certifications.length > 0) ? content.certifications[0] : null; %>
                    
                    <% if (cert) { %>
                        <div class="cert-interactive-card" id="cert-trigger">
                            <img 
                                src="<%= cert.image %>" 
                                alt="<%= cert.title || 'Certification' %> - Thumbnail" 
                                class="cert-img-thumb"
                                width="400"
                                height="565"
                                loading="lazy"
                            >
                            <div class="cert-hover-overlay">
                                <span class="cert-icon-zoom">🔍 View Full Size</span>
                            </div>
                        </div>
                    <% } %>
                </article>

            </div>
        </section>

        <% if (cert) { %>
        <div class="cert-modal" id="cert-modal">
            <div class="cert-modal-overlay" id="cert-overlay"></div>
            <div class="cert-modal-content">
                <button class="cert-close-btn" id="cert-close" aria-label="Close view">&times;</button>
                <img 
                    src="<%= cert.image %>" 
                    alt="<%= cert.title || 'Certification' %> - Full View" 
                    class="cert-img-full"
                >
            </div>
        </div>
        <% } %>
    </main>

    <%- include('partials/footer') %>

    <script src="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.js"></script>
    <script src="js/main.js"></script>
    <script src="js/common.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>
    
    <script>
        // Initialize AOS (Animate On Scroll) library
        AOS.init({
            duration: 1000,
            once: true,
        });

        // Wait for the DOM to be fully loaded
        document.addEventListener('DOMContentLoaded', () => {
            // Register GSAP plugins
            gsap.registerPlugin(ScrollTrigger);
            
            // Initialize animations
            initAboutSectionAnimations();
            initCertificationsAnimations();
        });

        // About Section Animations
        function initAboutSectionAnimations() {
            const aboutSection = document.querySelector('.about-section');
            if (!aboutSection) return;
            
            // Create timeline for the entire section animation
            const tl = gsap.timeline({
                scrollTrigger: {
                    trigger: '.about-section',
                    start: 'top 70%',
                    toggleActions: 'play none none none',
                }
            });

            // Animate text content (left column)
            tl.from('.section-paragraph', {
                duration: 0.8,
                opacity: 0,
                y: 30,
                stagger: 0.2,
                ease: 'power3.out'
            })
            .from('.info-box', {
                duration: 1,
                opacity: 0,
                y: 50,
                stagger: 0.3,
                ease: 'back.out(1.7)'
            }, '-=0.5');

            // Animate image (right column) separately
            gsap.from('.about-image', {
                scrollTrigger: {
                    trigger: '.about-section',
                    start: 'top 70%',
                    toggleActions: 'play none none none',
                },
                duration: 1.5,
                opacity: 0,
                x: 100,
                ease: 'power3.out'
            });
        }

        // Certifications Section Animations
        function initCertificationsAnimations() {
            const certSection = document.querySelector('.cert-section');
            if (!certSection) return;
            
            // Page load animations
            const tl = gsap.timeline({
                scrollTrigger: {
                    trigger: '.cert-section',
                    start: 'top 75%',
                    toggleActions: 'play none none reverse'
                }
            });

            tl.to('.cert-title', { y: 0, opacity: 1, duration: 0.8, ease: 'power3.out' })
              .to('.cert-thumbnail-wrapper', { y: 0, opacity: 1, duration: 0.8 }, '-=0.6');
            
            // Initialize modal functionality
            initCertModal();
        }

        // Certifications Modal Logic
        function initCertModal() {
            const modal = document.querySelector('#cert-modal');
            const trigger = document.querySelector('#cert-trigger');
            const closeBtn = document.querySelector('#cert-close');
            const overlay = document.querySelector('#cert-overlay');
            const modalContent = document.querySelector('.cert-modal-content');
            
            if (!trigger || !modal) return;
            
            // Function to open modal
            function openModal() {
                document.body.style.overflow = 'hidden';
                
                gsap.to(modal, { autoAlpha: 1, duration: 0.3 });
                gsap.fromTo(modalContent, 
                    { scale: 0.8, opacity: 0 }, 
                    { scale: 1, opacity: 1, duration: 0.4, ease: 'back.out(1.7)' }
                );
            }

            // Function to close modal
            function closeModal() {
                document.body.style.overflow = '';
                gsap.to(modal, { autoAlpha: 0, duration: 0.3 });
            }

            // Event Listeners
            trigger.addEventListener('click', openModal);
            closeBtn.addEventListener('click', closeModal);
            overlay.addEventListener('click', closeModal);
            
            // Close on Escape key
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') closeModal();
            });
        }
    </script>
</body>
</html>